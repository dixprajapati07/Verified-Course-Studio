# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
# If left empty or unreachable, an in-memory MongoDB instance will be used automatically for local dev
MONGODB_URI=mongodb://localhost:27017/verified_course_studio

# Execution Service (Optional: Custom isolated runner endpoint)
# Defaults to Wandbox isolated containerized execution
EXECUTION_SERVICE_URL=https://wandbox.org/api/compile.json
EXECUTION_TIMEOUT_MS=6000
MAX_OUTPUT_BYTES=65536

# AI Provider Keys (Optional: If omitted, deterministic verified pedagogical engine is used)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Security
JWT_SECRET=verified_course_studio_dev_secret_key_2026
