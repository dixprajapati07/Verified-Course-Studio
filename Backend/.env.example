# Verified Course Studio — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Server
PORT=5000

# Supabase (required for auth + database persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-public-key

# AI Providers — configure at least ONE. The more you configure, the more fallback options.

# Google Gemini (free tier available at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Groq (free tier available at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI (free tier at https://dash.cloudflare.com)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# ElevenLabs text-to-speech for slide narration
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

